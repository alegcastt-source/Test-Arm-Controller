<?xml version="1.0"?>
<package format="2">
  <name>fetch_twist_controller</name><version>0.1.0</version>
  <description>Resolved rate control and evaluation for Fetch Gazebo, ROS Noetic.</description>
  <maintainer email="maintainer@example.com">IRVL workspace maintainer</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend><depend>rospy</depend><depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend><depend>pluginlib</depend>
  <depend>robot_controllers_interface</depend><depend>robot_controllers</depend>
  <exec_depend>robot_controllers_msgs</exec_depend><exec_depend>actionlib</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf</exec_depend><exec_depend>kdl_parser_py</exec_depend>
  <exec_depend>urdfdom_py</exec_depend><exec_depend>python3-pykdl</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>fetch_gazebo</exec_depend><exec_depend>fetch_description</exec_depend>
  <export><robot_controllers plugin="${prefix}/plugins.xml"/></export>
</package>
